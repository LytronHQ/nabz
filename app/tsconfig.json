{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts", "tests"],
	// The service worker is its own TypeScript project (src/service-worker/tsconfig.json)
	// with WebWorker types; included here it would type-check against the DOM.
	"exclude": ["src/service-worker"]
}
