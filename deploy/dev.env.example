# Local development — VMs created in Virtual Machine Manager / libvirt (KVM).
# Copy to deploy/dev.env and fill in. deploy/*.env is gitignored.

SSH_USER=root
SSH_KEY=~/.ssh/id_ed25519

# Self-hosted PocketBase (the `pocketbase` node below). Point workers/evaluator at
# that VM's IP:8090 — an address the VMs can reach (not 127.0.0.1).
PB_URL=http://192.168.122.10:8090
PB_AUTH_COLLECTION=service_accounts

# Superuser for the pocketbase node (used to import the schema + seed accounts).
PB_SUPERUSER_EMAIL=admin@monitors.local
PB_SUPERUSER_PASSWORD=

# Web node (the SvelteKit app). Secret for the OAuth PKCE cookie — any non-empty
# string for dev; ORIGIN is set to http://<web-ip>:3000 automatically.
PKCE_FLOW_ENCRYPTION_KEY=dev-only-not-a-secret

# Scoped service-account creds (service_accounts records: role=worker / role=evaluator).
# On a self-hosted PB these are also seeded by the pocketbase node on first deploy.
WORKER_PB_USERNAME=worker@svc.local
WORKER_PB_PASSWORD=
EVALUATOR_PB_USERNAME=evaluator@svc.local
EVALUATOR_PB_PASSWORD=

# Email alerts (optional). The evaluator sends email channels via SMTP only when
# BOTH SMTP_HOST and SMTP_FROM are set; otherwise email channels are skipped.
# Example — Postmark (https://postmarkapp.com):
#   SMTP_HOST=smtp.postmarkapp.com, SMTP_PORT=587
#   SMTP_USERNAME and SMTP_PASSWORD are BOTH your Postmark *Server API Token*
#     (Postmark uses the server token for both the SMTP user and password).
#   SMTP_FROM must be a verified Sender Signature (or an address on a verified domain).
#   New Postmark accounts are approval-gated — until approved you can only send to
#   your own verified addresses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Health endpoint (#103): shared across all nodes. Set a token to unlock the
# scrubbed, bearer-gated debug detail on /health and /health/all; leave blank to
# expose only the minimal public ok/degraded tier.
HEALTH_DEBUG_TOKEN=

# Nodes to deploy: one line per host, "role ip [zone]". zone is required for workers.
# List `pocketbase` FIRST so it's up + seeded before workers/evaluator authenticate.
NODES="
pocketbase 192.168.122.10
web 192.168.122.30
worker 192.168.122.11 eu
evaluator 192.168.122.20
"

# --- default app users (#392) ------------------------------------------------
# Provisioning seeds two ORDINARY users in PocketBase's `users` collection, so a
# fresh environment can be signed into without creating records by hand:
#
#   admin@nabz.sh   the "admin" one — but see below, seeding grants nothing
#   user@nabz.sh    a regular user
#
# Both are created verified, with this password, and with
# must_change_password=true — the shared default cannot survive first sign-in:
# every route redirects to /change-password until it is replaced.
#
# Existing records are never modified, so re-running provisioning will not reset a
# password or re-raise the flag on an account that has already rotated.
#
# ADMIN_EMAILS IS WHAT MAKES THE ADMIN AN ADMIN. It is the allowlist that gates
# /admin/usage; seeding the account by itself confers no privileges at all. If
# SEED_ADMIN_EMAIL is changed, change ADMIN_EMAILS to match (see web.env.example).
# SEED_ADMIN_EMAIL=admin@nabz.sh
# SEED_USER_EMAIL=user@nabz.sh
# SEED_PASSWORD=demo1234

# --- auth cookie (#394) -------------------------------------------------------
# The libvirt dev fleet is served over plain HTTP, and a browser SILENTLY discards
# a Secure cookie on an http:// origin — no error, nothing in the console. The
# symptom is a sign-in that returns to /signin as though the password were wrong.
#
# false ONLY because this fleet has no TLS. Never set it false anywhere reachable
# off the host: it puts the session cookie on the wire in clear.
COOKIE_SECURE=false

