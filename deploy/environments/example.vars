# example.vars — the non-secret half of an environment's config.
#
#   cp deploy/environments/example.vars deploy/environments/production.vars
#
# Name the copy after the environment: `production.vars`, `staging.vars`. Every
# tool here derives the path from the environment name you pass it.
#
# This file is committed, so nothing in it may be a secret. Secret VALUES live in
# Bitwarden Secrets Manager; bws-env.sh merges the two into a disposable
# deploy/.materialized/<env>.env, and setup-env.sh pushes every key below to
# GitHub as an *environment variable* (not a secret) for the workflows to read.
#
# Values written in angle brackets must be replaced. `setup-env.sh <env>
# --status` reports any still unfilled, so a half-configured environment fails
# loudly instead of provisioning with blanks.

# --- Bitwarden --------------------------------------------------------------
# The BWS project holding this environment's secrets. An id, not a credential.
BWS_PROJECT_ID=<BWS_PROJECT_ID>
# Optional second project for values that are genuinely one account across all
# environments (SMTP, Cloudflare, the GitHub PAT). The environment project wins
# on a clash. Leave empty to use one project for everything.
BWS_SHARED_PROJECT_ID=

# --- SSH --------------------------------------------------------------------
# Filename under ~/.ssh of the private key that reaches this fleet. The key
# itself is never copied here — setup-env.sh reads that path and pushes it.
SSH_KEY_FILE=id_ed25519_nabz_example

# --- Fleet identity ---------------------------------------------------------
# Environment name, and the label every provisioned resource is tagged with.
# The workflows pass this as an input; it matters when running the scripts by
# hand, where it is what scopes a teardown to one fleet.
ENVIRONMENT=production
# Prefix for server names: <prefix>-pocketbase, <prefix>-worker-fra, and so on.
SERVER_PREFIX=nabz-example
# Hetzner private network. Created on first provision if it does not exist.
PRIVATE_NETWORK=nabz-example-net

# --- Cloudflare and hostnames -----------------------------------------------
# The zone that holds the hostnames below. Must already exist in Cloudflare.
CF_ZONE_NAME=example.com
# Hostname the PocketBase tunnel answers on, and what Access is applied to.
PB_HOSTNAME=pb.example.com
# Cloudflare Tunnel name. Created on first provision if it does not exist.
TUNNEL_NAME=nabz-example
# Cloudflare Access application name guarding PB_HOSTNAME.
ACCESS_APP_NAME=nabz-example-pb
# Public URL of the web app. External monitoring probes this.
WEB_URL=https://status.example.com
# wrangler environment for `wrangler deploy --env`. Empty = the default one.
WRANGLER_ENV=

# --- PocketBase -------------------------------------------------------------
# Version to install, and the version an upgrade rolls back to.
PB_VERSION=0.28.4
# Superuser identity. The password is a Bitwarden secret, not a value here.
PB_SUPERUSER_EMAIL=<PB_SUPERUSER_EMAIL>
# Service-account usernames the worker and evaluator authenticate as. Their
# passwords are Bitwarden secrets; these are only the names to seed and log in.
WORKER_PB_USERNAME=worker@example.com
EVALUATOR_PB_USERNAME=evaluator@example.com

# --- Alerting and email -----------------------------------------------------
# Comma-separated addresses that get operational alerts and admin access.
ADMIN_EMAILS=<ADMIN_EMAILS>
# Outbound SMTP. Username and password are Bitwarden secrets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=alerts@example.com
# From-address for the scheduled email-delivery canary.
CANARY_FROM=canary@example.com

# --- Backups ----------------------------------------------------------------
# S3-compatible bucket for PocketBase backups. The endpoint is derived from the
# Cloudflare account id, and the keys are Bitwarden secrets. Empty = no backups.
PB_BACKUP_S3_BUCKET=nabz-example-backups

# --- External monitoring ----------------------------------------------------
# `off` skips Better Stack setup for this environment. Worth turning off where
# a fleet is short-lived — alerts nobody acts on train you to ignore all of them.
EXTERNAL_WATCH=on

# Not set here: NODES, PB_URL, PB_BIND_IP, PB_DATA_DEVICE and PRIVATE_SUBNET are
# written back to Bitwarden by provisioning, because only provisioning knows
# them. Adding them by hand puts a stale copy ahead of the real one.
