# PocketBase node — self-hosted PB. Copy to /etc/monitors/pocketbase.env (or let
# remote-deploy.sh push it). The superuser is used to import the schema, seed the
# service accounts, and apply settings on first run. Everything below is applied
# by setup-pocketbase.sh — nothing is configured by hand in the admin UI.

PB_SUPERUSER_EMAIL=admin@monitors.local
PB_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# Pinned PocketBase release the image is built from (deploy/pocketbase/Dockerfile).
# Optionally pin the sha256 of the linux_amd64 release zip for a verified build.
PB_VERSION=0.28.4
PB_SHA256=

# Where pb_data lives. Blank = a local docker volume on this host's disk (fine
# for dev). On prod set this to the attached Hetzner Volume's device — the path
# provision.sh prints, or "auto" to pick the single attached volume (#331).
# setup-pocketbase.sh formats it only if blank, mounts it at PB_DATA_MOUNT with
# a nofail fstab entry, and bind-mounts that into the container.
PB_DATA_DEVICE=
PB_DATA_MOUNT=/mnt/pb-data

# PocketBase's own request-log level (0=info logs every API request, 4=warn).
# Keep at 4: at 0 the request log outgrew the real data 21x on dev.
PB_LOGS_MIN_LEVEL=4

# Service accounts to create (role=worker / role=evaluator). When deploying via
# remote-deploy.sh these are filled from WORKER_PB_* / EVALUATOR_PB_* so they stay
# in sync with what the worker/evaluator nodes authenticate with.
SEED_WORKER_USERNAME=worker@svc.local
SEED_WORKER_PASSWORD=
SEED_EVALUATOR_USERNAME=evaluator@svc.local
SEED_EVALUATOR_PASSWORD=

# --- Application settings (applied via /api/settings) ------------------------
# App name + URL appear in verification / password-reset emails.
PB_APP_NAME=nabz
PB_APP_URL=https://nabz.sh
PB_SENDER_NAME=nabz
PB_SENDER_ADDRESS=no-reply@nabz.sh

# PB's OWN SMTP — for signup verification + password resets. This is SEPARATE
# from the evaluator's alert SMTP; both point at the same MailerSend domain but
# are configured independently. SMTP is applied only if PB_SMTP_HOST is set.
# MailerSend: host smtp.mailersend.net, port 587 (STARTTLS ⇒ PB_SMTP_TLS=false),
# username + password are the SMTP credentials MailerSend generates for the
# verified domain (a distinct username and password).
PB_SMTP_HOST=
PB_SMTP_PORT=587
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=false

# Automatic backups to Cloudflare R2 (S3-compatible). Applied only if BOTH
# endpoint and bucket are set. R2 endpoint looks like
# https://<accountid>.r2.cloudflarestorage.com ; region "auto".
PB_BACKUP_S3_ENDPOINT=
PB_BACKUP_S3_BUCKET=
PB_BACKUP_S3_REGION=auto
PB_BACKUP_S3_ACCESS_KEY=
PB_BACKUP_S3_SECRET=
PB_BACKUP_CRON=0 3 * * *
PB_BACKUP_MAX_KEEP=7
