# Web node — the SvelteKit app. Copy to /etc/monitors/web.env (or let
# remote-deploy.sh push it, which fills PB_URL/ORIGIN for you).

# PocketBase the app talks to (server-side). Same PB_URL the workers use.
PB_URL=http://192.168.122.89:8090

# Heartbeat check-ins (/ping/{token}) record to PocketBase with a service account.
# remote-deploy fills these — defaulting to the evaluator's creds unless you set a
# dedicated WEB_PB_USERNAME/WEB_PB_PASSWORD. Leave unset to disable heartbeats.
WEB_PB_COLLECTION=service_accounts
WEB_PB_USERNAME=
WEB_PB_PASSWORD=

# Secret for encrypting the OAuth PKCE cookie (any non-empty string; only
# exercised for OAuth logins). Use a real random value in production.
PKCE_FLOW_ENCRYPTION_KEY=dev-only-not-a-secret

# Public origin the browser uses to reach this app — must match, or SvelteKit
# rejects form POSTs (login). remote-deploy sets this to http://<node-ip>:3000.
ORIGIN=http://192.168.122.30:3000

# Leave unset over plain http (secure cookies would break login). Set to
# `production` only once the app is served over TLS.
NODE_ENV=

# --- Public /api/health (fleet aggregate) ---
# GET /api/health returns only ok/degraded (+ unhealthy node names) — safe to
# expose to an external uptime monitor. Set a token to unlock the scrubbed debug
# detail (bearer-gated); leave blank for public-only. HEALTH_STALE_SECONDS is how
# long a node may be silent before it's counted stale (default 90).
HEALTH_DEBUG_TOKEN=
HEALTH_STALE_SECONDS=90

# --- Admin usage page (/admin/usage) ---
# Comma/space-separated allowlist of emails that may see the private usage
# dashboard. Empty = nobody. Kept separate from HEALTH_DEBUG_TOKEN.
# Also the switch that makes the seeded admin an admin (#392): provisioning
# creates admin@nabz.sh as an ordinary user, and only this allowlist grants it
# /admin/usage. Seeding alone grants nothing.
ADMIN_EMAILS=

# Secure flag on the auth cookie (#394). Leave unset (or true) anywhere served
# over HTTPS, which is every real deployment. Set false only for a fleet on plain
# HTTP — the libvirt dev VMs — where a Secure cookie is dropped by the browser and
# sign-in appears to fail.
# COOKIE_SECURE=true

