# --- monitors evaluator config ---
# Copy to /etc/monitors/evaluator.env and fill in. Keep it private (chmod 600).

PB_URL=https://monitors.pockethost.io

# Scoped least-privilege service account (see deploy/README.md). Create a
# service_accounts record with role=evaluator in the PB admin and use its creds.
PB_AUTH_COLLECTION=service_accounts
PB_ADMIN_USERNAME=evaluator@svc.example.com
PB_ADMIN_PASSWORD=

# --- Optional email alerts (leave SMTP_HOST blank to disable email channels) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional dead-man's switch: alert here when a zone stops sending heartbeats ---
OPS_WEBHOOK_URL=

# External dead-man's switch (optional). When set, the evaluator GETs this URL at
# the end of each completed pass, at most once a minute — so a Healthchecks.io
# check going silent means the evaluator stopped, which nothing inside nabz can
# report. Unset = off.
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
DEADMAN_SECONDS=90

# --- Optional: warn this many days before a monitored HTTPS cert expires (default 14) ---
CERT_EXPIRY_WARN_DAYS=14

# --- Health endpoint (#103) ---
# GET /health (this node) and GET /health/all (fleet aggregate) return only
# ok/degraded (+ unhealthy zone names) — safe to expose publicly. Set a token to
# unlock the scrubbed debug detail (bearer-gated); leave blank for public-only.
# HEALTH_ADDR=off disables the server; HEALTH_PORT is the published host port.
HEALTH_DEBUG_TOKEN=
HEALTH_PORT=8080
