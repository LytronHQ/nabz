# --- monitors worker node config ---
# Copy to /etc/monitors/worker.env and fill in. Keep it private (chmod 600).

PB_URL=https://monitors.pockethost.io

# Scoped least-privilege service account (see deploy/README.md). Create a
# service_accounts record with role=worker in the PB admin and use its creds.
# Leave PB_AUTH_COLLECTION blank to fall back to a superuser login.
PB_AUTH_COLLECTION=service_accounts
PB_ADMIN_USERNAME=worker@svc.example.com
PB_ADMIN_PASSWORD=

# This node's zone. A monitor with no zones runs everywhere; a monitor that
# lists zones runs only on workers whose REGION_NAME matches.
REGION_NAME=eu

# SSRF guard (#268). When true, checks may only reach PUBLIC IPs — targets (and
# redirect hops) resolving to loopback / private / link-local / cloud-metadata
# addresses are refused. Leave OFF for the normal eu/us zones (and it must be off
# where checks legitimately hit private hosts). The anonymous "free" zone (#265)
# sets this to true, since it runs untrusted, unauthenticated targets.
# BLOCK_PRIVATE_TARGETS=false

# --- Health endpoint (#103) ---
# GET /health returns only ok/degraded (safe to expose publicly). Set a token to
# unlock the scrubbed debug detail (bearer-gated); leave blank for public-only.
# HEALTH_ADDR=off disables the server; HEALTH_PORT is the published host port.
HEALTH_DEBUG_TOKEN=
# A range rather than a fixed host port — Docker picks one from it.
HEALTH_PORT_RANGE=8080-8099

# --- A worker on Fly.io (optional) ---
# A zone can span hosts: add `fly <app-name> <zone> [region]` to NODES and the
# normal deploy ships it alongside the VMs, from the same commit. It reaches
# PocketBase through the public tunnel instead of the private network, so it
# needs its OWN Cloudflare Access service token — separate from the web's so
# either can be revoked alone. Written by infra-access.
# FLY_CF_ACCESS_CLIENT_ID=
# FLY_CF_ACCESS_CLIENT_SECRET=

# --- Scaling ---
# A zone is EXACTLY ONE worker. The schedule lives inside the worker process, so
# a second replica does not share the first one's queue — it keeps its own copy of
# the whole zone schedule and probes every monitor a second time.
#
# A zone may hold any number of workers, here and on other hosts. They heartbeat
# into worker_heartbeats, derive the zone's roster from it and each check only
# their own share, so adding one adds capacity rather than duplicate probes.
#
# WORKER_REPLICAS runs several on THIS node (up to the 4 declared in
# worker.yml). Each is a separate service with a stable id derived from
# WORKER_ID, so redeploys do not disturb the zone; setup-worker.sh refuses
# replicas without one.
# WORKER_REPLICAS=1
#
# Capacity inside a single worker is WORKER_CONCURRENCY: how many checks it runs
# at once (default 8). Raise it for a zone with many monitors or slow targets; a
# check is network-bound, so this is not a CPU count. Reach for it before adding
# workers — it costs nothing and needs no coordination.
# WORKER_CONCURRENCY=8
#
# A STABLE id for this worker. It orders the zone's roster and therefore decides
# which monitors this worker checks, so a changing id re-shards the zone on every
# deploy. remote-deploy.sh derives one from the zone and node address; set it
# here only to override that.
# WORKER_ID=

# Ops identity for logs/health/heartbeat — NOT the zone, and never written to a
# check row. Blank means the container hostname, which is unique per replica.
# WORKER_ID=

# "Is it us?" (#598): after a failed check the worker probes these. If any is
# unreachable, the failure is stored as inconclusive (nabz's network, not the
# site's): no incident, not counted in uptime. Unset = Cloudflare's /cdn-cgi/trace
# and Google's generate_204; "off" = every failure counts.
# WORKER_CANARY_URLS=
